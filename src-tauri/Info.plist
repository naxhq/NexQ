<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for microphone capture (and for capturing the BlackHole virtual
	     input device). Without this key macOS terminates the app the first time it
	     tries to access audio input. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>NexQ captures audio so it can transcribe and assist during your calls.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>NexQ captures audio played by your selected output device to transcribe the other participants in your calls.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
