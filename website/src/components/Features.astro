---
import FeatureRow from './FeatureRow.astro';
import ScopePicker from './ScopePicker.astro';
import Icon from './Icon.astro';
import { STT_PROVIDERS, doc } from '../data/site';

const base = import.meta.env.BASE_URL;
const actions = [
  { key: 'Space', label: 'Assist' },
  { key: '1', label: 'What to say' },
  { key: '2', label: 'Shorten' },
  { key: '3', label: 'Follow-up' },
  { key: '4', label: 'Recap' },
  { key: '5', label: 'Ask' },
];
---

<section id="features" class="section" aria-labelledby="features-title">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow">Features</p>
      <h2 id="features-title" class="h2 mt-4">Everything you need in the moment. Nothing that gets in the way.</h2>
      <p class="lede">
        NexQ sits beside your meeting app as a compact, always-on-top overlay. It listens, keeps the transcript, and has
        an answer ready when you need one.
      </p>
    </div>

    <div class="mt-8 divide-y divide-line">
      <FeatureRow id="transcription" eyebrow="Real-time transcription" title="Hears both sides, and knows who is speaking.">
        <p>
          Your microphone and your computer's audio are captured as two separate streams, <span class="text-ink">You</span>
          and <span class="text-them">Them</span>, each with its own speech engine, mute and level. Continuous speech is
          merged into readable paragraphs.
        </p>
        <p>
          On Deepgram, remote voices are told apart as Speaker 1, Speaker 2 and so on, and you can rename them. Live
          translation is built in, through five translation providers.
        </p>
        <div>
          <p class="mb-3 text-sm text-ink-3">11 speech engines. Six need no API key, five run entirely offline.</p>
          <ul class="flex flex-wrap gap-2" aria-label="Speech-to-text engines">
            {STT_PROVIDERS.map((p) => (
              <li class:list={['chip py-0.5! text-[0.8125rem]!', p.local && 'border-live/25! text-ink!']}>
                {p.local && <span class="h-1.5 w-1.5 rounded-full bg-live" aria-hidden="true"></span>}
                {p.name}
                {p.local && <span class="sr-only">(no API key)</span>}
              </li>
            ))}
          </ul>
        </div>
        <img
          slot="visual"
          src={`${base}img/transcription.webp`}
          width="898"
          height="1082"
          alt="NexQ transcript with Interviewer lines in amber and You lines in green, each followed by a live Chinese translation."
          class="frame mx-auto w-full max-w-[34rem]"
          loading="lazy"
          decoding="async"
        />
      </FeatureRow>

      <FeatureRow id="copilot" eyebrow="AI copilot" title="One key, and the answer starts streaming." reverse>
        <p>
          NexQ detects questions as they are asked. Press a key for help that fits the moment: an answer, a shorter
          version, a follow-up, a recap, or your own question.
        </p>
        <ul class="grid grid-cols-2 gap-x-6 gap-y-2.5 text-[0.9375rem] sm:grid-cols-3" aria-label="Meeting shortcuts">
          {actions.map((a) => (
            <li class="flex items-center gap-2.5">
              <kbd class="kbd">{a.key}</kbd>
              <span class="text-ink-2">{a.label}</span>
            </li>
          ))}
        </ul>
        <p>
          Choose exactly what the AI reads with the context picker: since your last answer, the last few minutes, or the
          whole meeting. A live progress panel shows each phase, and every answer of the meeting stays in the history.
        </p>
        <div slot="visual" class="relative">
          <img
            src={`${base}img/copilot.webp`}
            width="883"
            height="803"
            alt="The NexQ answer panel: a detected interview question at the top, action buttons for Assist, Say, Short, Follow-up, Recap and Ask, and a structured streamed answer below."
            class="frame w-full"
            loading="lazy"
            decoding="async"
          />
          <div class="relative -mt-16 ml-4 sm:absolute sm:-bottom-8 sm:-left-6 sm:mt-0 sm:ml-0">
            <ScopePicker />
          </div>
        </div>
      </FeatureRow>

      <FeatureRow id="documents" eyebrow="Your documents" title="Answers grounded in your résumé, notes and specs.">
        <p>
          Drop in PDF, Word, Markdown or text files. NexQ indexes them on your machine with a hybrid of vector and
          full-text search, so answers draw on what you actually wrote, not on guesses.
        </p>
        <p>
          Running on a laptop without a GPU? Gemini Context Cache uploads your documents once per session and skips local
          embedding entirely.
        </p>
        <p>
          <a href={doc('rag-context')} class="link inline-flex items-center gap-1" target="_blank" rel="noopener">
            How document context works <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
          </a>
        </p>
        <img
          slot="visual"
          src={`${base}img/rag.webp`}
          width="602"
          height="1139"
          alt="NexQ knowledge base panel listing indexed documents (a résumé PDF, a job description, interview notes) with chunk counts and a token budget bar."
          class="frame mx-auto w-full max-w-[22rem]"
          loading="lazy"
          decoding="async"
        />
      </FeatureRow>
    </div>
  </div>
</section>
