---
/**
 * #privacy: "Nothing leaves unless you choose it". A typographic list of claims, each backed by the repo:
 *   no bot, audio on your device ........ README.md "How it works" ("Audio is captured on your machine ... No bot joins your call"),
 *                                         docs FAQ in data/site.ts
 *   you decide where data goes .......... README.md "Privacy" ("Nothing leaves your machine unless you choose a cloud provider")
 *   stored on your machine .............. README.md "Privacy" (meetings, transcripts, recordings, models and the RAG index live
 *                                         in the app data folder, %APPDATA%\com.nexq.app); no account README.md "Why NexQ";
 *                                         local SQLite database (CLAUDE.md, Tech Stack)
 *   keys in the OS vault ................ README.md "Privacy" and "Personal sources" (Windows Credential Manager, macOS Keychain; personal
 *                                         source secrets too); src-tauri/src/credentials/
 *   signed updates ...................... README.md "Quick start" (installs on quit, never mid-meeting) and "Privacy" (Ed25519)
 *   open source MIT ..................... README.md "Why NexQ", LICENSE
 *   no telemetry ........................ README.md "Privacy" (only contacts GitHub, for update checks and their release notes (src/lib/changelog.ts:31-38 fetches CHANGELOG.md from raw.githubusercontent.com), besides your providers and the model downloads: src-tauri/src/stt/local_engines/model_registry.rs, translation/opus_mt_registry.rs fetch from huggingface.co and github.com)
 *   consent line ........................ docs/user-guide/meeting-detection.md (last line)
 * No analytics on this site: owner decision.
 */
import { SECTION, REPO } from '../data/site';

const ROWS: { k: string; h: string; p: string; link?: { href: string; label: string } }[] = [
  {
    k: 'capture',
    h: 'No bot in your call.',
    p: 'NexQ captures audio on your own device, from your microphone and your system audio. Nobody is added to the meeting, so it works with any meeting app.',
  },
  {
    k: 'choice',
    h: 'You decide where your words go.',
    p: 'Pair an on-device speech engine with Ollama or LM Studio and your audio and words stay on your computer. Pick a cloud provider and it receives only what you send it.',
    link: { href: '#ai', label: 'See the options' },
  },
  {
    k: 'storage',
    h: 'Stored on your machine.',
    p: 'Meetings, transcripts, recordings, models and the search index live in a local database and folder on your computer. There is no NexQ cloud and no account.',
  },
  {
    k: 'keys',
    h: 'Keys in the system vault.',
    p: 'API keys, and the secrets for your personal sources, go to Windows Credential Manager or the macOS Keychain. They are never written to NexQ’s settings file.',
  },
  {
    k: 'updates',
    h: 'Signed updates.',
    p: 'Every update is verified with an Ed25519 signature before it installs. Updates download quietly, install when you quit, and never start during a meeting.',
  },
  {
    k: 'code',
    h: 'Open source, MIT.',
    p: 'Read the code, check every claim on this page, or build it yourself. No account and no usage caps.',
    link: { href: REPO, label: 'The code on GitHub' },
  },
  {
    k: 'tracking',
    h: 'No tracking.',
    p: 'NexQ has no telemetry or analytics. Besides the providers you set up and the models you choose to download, it only contacts GitHub, to check for updates and show their release notes. This website has no analytics either.',
  },
];
---

<section id={SECTION.privacy} class="section" aria-labelledby="privacy-title">
  <div class="wrap pv">
    <div class="pv-intro">
      <h2 id="privacy-title" class="h2">Nothing leaves unless you choose it.</h2>
      <p class="lede">Your calls are yours, and the code is open, so you can check that instead of taking our word for it.</p>
      <p class="pv-note">
        Please tell the other people on the call that you are transcribing it. Many places require it.
      </p>
    </div>

    <div class="pv-rows">
      {ROWS.map((r) => (
        <article class="pv-row" data-reveal>
          <p class="pv-k">{r.k}</p>
          <div>
            <h3 class="pv-h">{r.h}</h3>
            <p class="pv-p">{r.p}</p>
            {r.link && <p class="pv-l"><a class="link" href={r.link.href}>{r.link.label}</a></p>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pv {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .pv {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 5rem;
    }
    .pv-intro {
      position: sticky;
      top: calc(var(--nav-h) + 2rem);
      align-self: start;
    }
  }
  .pv-note {
    margin-top: 2rem;
    max-width: 30ch;
    font-size: 0.875rem;
    line-height: 1.55;
    color: hsl(var(--muted-foreground));
  }
  .pv-rows {
    border-top: 1px solid hsl(var(--border));
  }
  .pv-row {
    display: grid;
    gap: 0.5rem 2rem;
    padding: 2rem 0 2.25rem;
    border-bottom: 1px solid hsl(var(--border));
  }
  @media (min-width: 640px) {
    .pv-row {
      grid-template-columns: 6.5rem minmax(0, 1fr);
    }
  }
  .pv-k {
    padding-top: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: hsl(var(--muted-foreground));
  }
  .pv-h {
    font-size: clamp(1.625rem, 1.6vw + 1.1rem, 2.375rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }
  .pv-p {
    max-width: 36rem;
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: hsl(var(--muted-foreground));
  }
  .pv-l {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
  }
</style>
