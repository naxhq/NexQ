---
/**
 * #privacy: "Private by design". A typographic list of claims, each backed by the repo:
 *   no bot, audio on your device ........ README.md L40 ("Audio is captured on your machine ... No bot joins your call"),
 *                                         docs FAQ in data/site.ts
 *   you decide where data goes .......... README.md L216 ("Nothing leaves your machine unless you choose a cloud provider")
 *   stored on your machine .............. README.md L217 (meetings, transcripts, recordings, models and the RAG index live
 *                                         in the app data folder, %APPDATA%\com.nexq.app); no account README.md L41;
 *                                         local SQLite database (CLAUDE.md, Tech Stack)
 *   keys in the OS vault ................ README.md L218 and L212 (Windows Credential Manager, macOS Keychain; personal
 *                                         source secrets too); src-tauri/src/credentials/
 *   signed updates ...................... README.md L123 (installs on quit, never mid-meeting) and L219 (Ed25519)
 *   open source MIT ..................... README.md L41, LICENSE
 *   no telemetry ........................ README.md L219 (only contacts GitHub Releases for updates, besides your providers)
 *   consent line ........................ docs/user-guide/meeting-detection.md (last line)
 * No analytics on this site: owner decision.
 */
import { SECTION, REPO } from '../data/site';

const ROWS: { k: string; h: string; p: string; link?: { href: string; label: string } }[] = [
  {
    k: 'capture',
    h: 'No bot in your call.',
    p: 'NexQ captures audio on your own device, from your microphone and your system audio. Nobody is added to the meeting, so it works with any meeting app.',
  },
  {
    k: 'routing',
    h: 'You decide where your words go.',
    p: 'Pair an on-device speech engine with Ollama or LM Studio and nothing leaves your computer. Pick a cloud provider and it receives only what you send it.',
    link: { href: '#ai', label: 'See the options' },
  },
  {
    k: 'storage',
    h: 'Stored on your machine.',
    p: 'Meetings, transcripts, recordings, models and the search index live in a local database and folder on your computer. There is no NexQ cloud and no account.',
  },
  {
    k: 'keys',
    h: 'Keys in the system vault.',
    p: 'API keys, and the secrets for your personal sources, go to Windows Credential Manager or the macOS Keychain. They are never written to NexQ’s settings file.',
  },
  {
    k: 'updates',
    h: 'Signed updates.',
    p: 'Every update is verified with an Ed25519 signature before it installs. Updates download quietly, install when you quit, and never start during a meeting.',
  },
  {
    k: 'code',
    h: 'Open source, MIT.',
    p: 'Read the code, check every claim on this page, or build it yourself. No account and no usage caps.',
    link: { href: REPO, label: 'The code on GitHub' },
  },
  {
    k: 'tracking',
    h: 'No tracking.',
    p: 'NexQ has no telemetry or analytics. Besides the providers you set up, it only contacts GitHub Releases to look for updates. This website has no analytics either.',
  },
];
---

<section id={SECTION.privacy} class="section" aria-labelledby="privacy-title">
  <div class="wrap pv">
    <div class="pv-intro">
      <p class="eyebrow">throughout</p>
      <h2 id="privacy-title" class="h2 mt-3">Private by design</h2>
      <p class="lede">Your calls are yours. NexQ is built so that you can check that, not just take our word for it.</p>
      <p class="pv-note">
        Please tell the other people on the call that you are transcribing it. Many places require it.
      </p>
    </div>

    <div class="pv-rows">
      {ROWS.map((r) => (
        <article class="pv-row" data-reveal>
          <p class="pv-k">{r.k}</p>
          <div>
            <h3 class="pv-h">{r.h}</h3>
            <p class="pv-p">{r.p}</p>
            {r.link && <p class="pv-l"><a class="link" href={r.link.href}>{r.link.label}</a></p>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pv {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .pv {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 5rem;
    }
    .pv-intro {
      position: sticky;
      top: calc(var(--nav-h) + 2rem);
      align-self: start;
    }
  }
  .pv-note {
    margin-top: 2rem;
    max-width: 30ch;
    font-size: 0.875rem;
    line-height: 1.55;
    color: hsl(var(--muted-foreground));
  }
  .pv-rows {
    border-top: 1px solid hsl(var(--border));
  }
  .pv-row {
    display: grid;
    gap: 0.5rem 2rem;
    padding: 2rem 0 2.25rem;
    border-bottom: 1px solid hsl(var(--border));
  }
  @media (min-width: 640px) {
    .pv-row {
      grid-template-columns: 6.5rem minmax(0, 1fr);
    }
  }
  .pv-k {
    padding-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: hsl(var(--muted-foreground));
  }
  .pv-h {
    font-size: clamp(1.625rem, 1.6vw + 1.1rem, 2.375rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }
  .pv-p {
    max-width: 36rem;
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: hsl(var(--muted-foreground));
  }
  .pv-l {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
  }
</style>
