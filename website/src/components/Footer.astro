---
import { REPO, RELEASES_URL, CHANGELOG, CONTRIBUTING, LICENSE, ISSUES, DOCS } from '../data/site';
import { CURRENT_VERSION } from '../data/releases';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

const links = [
  { label: 'Docs', href: DOCS },
  { label: 'Changelog', href: CHANGELOG },
  { label: 'Releases', href: RELEASES_URL },
  { label: 'GitHub', href: REPO },
  { label: 'License MIT', href: LICENSE },
  { label: 'Contributing', href: CONTRIBUTING },
  { label: 'Issues', href: ISSUES },
];
---

<footer class="border-t border-border" aria-labelledby="footer-title">
  <h2 id="footer-title" class="sr-only">Site footer</h2>
  <div class="wrap flex flex-col gap-8 py-12 md:flex-row md:items-start md:justify-between">
    <div>
      <a href={base} class="inline-flex items-center gap-2.5 rounded-lg" aria-label="NexQ home">
        <img src={`${base}img/logo-56.png`} alt="" width="28" height="28" class="rounded-[7px]" loading="lazy" />
        <span class="text-[1.05rem] font-bold tracking-tight text-foreground">NexQ</span>
      </a>
      <p class="mt-3 max-w-xs text-sm text-muted-foreground">
        Open-source AI meeting assistant and interview copilot for Windows and Mac.
      </p>
    </div>
    <nav aria-label="Project links">
      <ul class="flex flex-wrap gap-x-6 gap-y-1 md:max-w-md md:justify-end">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="inline-flex min-h-[36px] items-center text-sm text-muted-foreground transition-colors hover:text-foreground"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="wrap flex flex-col gap-2 border-t border-border py-6 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
    <span>© {year} Vahid Alizadeh and contributors</span>
    <span class="font-mono text-xs">v{CURRENT_VERSION}</span>
  </div>
</footer>
