---
/**
 * #releases "Every release has its own voice".
 * An interactive timeline: one real waveform per version (the same shape the app's update
 * dialog and installer draw, see Wave.astro / releases.ts). Selecting a version plays its wave
 * (only the --progress fill moves, never a bar height) and shows what shipped.
 *
 * Data is built at build time from CHANGELOG.md (RELEASES). Nothing is imported on the client:
 * the script reads the markup. Without JS the latest release is expanded and the rest are listed.
 */
import Icon from './Icon.astro';
import Wave from './Wave.astro';
import { RELEASES, CURRENT_VERSION } from '../data/releases';
import { CHANGELOG, SECTION } from '../data/site';

const MAX_ITEMS = 4;
/** On phones the list shows this many releases until the visitor asks for all of them. */
const PHONE_VISIBLE = 5;

interface Entry {
  /** Shown in the tab and the panel, e.g. "2.41.2". */
  version: string;
  /** Release the notes come from when it differs (a patch on top of a feature release). */
  notesFrom?: string;
  current: boolean;
  shortDate: string | null;
  dateLabel: string | null;
  headline: string;
  items: string[];
  more: number;
}

const entries: Entry[] = RELEASES.map((r, i) => {
  // The current release may be a patch (2.41.2) of the newest feature release (2.41.0).
  // Its wave is the one the installer shows today, so it takes the CURRENT_VERSION seed.
  const patch = i === 0 && r.version !== CURRENT_VERSION;
  const headline = r.oneLiner ?? r.items[0];
  // A release without a hand-written one-liner leads with its first line, so don't repeat it.
  // A one-liner that already covers a release's single item (2.41.0) would be repeated by the list, so the list stays hidden.
  const rest = r.oneLiner ? (r.items.length > 1 ? r.items : []) : r.items.slice(1);
  return {
    version: patch ? CURRENT_VERSION : r.version,
    notesFrom: patch ? r.version : undefined,
    current: i === 0,
    shortDate: r.dateLabel ? r.dateLabel.split(',')[0] : null,
    dateLabel: r.dateLabel,
    headline,
    items: rest.slice(0, MAX_ITEMS),
    more: Math.max(0, rest.length - MAX_ITEMS),
  };
});
---

<section id={SECTION.releases} class="section border-t border-border" aria-labelledby="releases-title">
  <div class="wrap">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-16">
      <div class="lg:col-span-7">
        <h2 id="releases-title" class="h2">Every release has its own voice.</h2>
        <p class="lede">
          NexQ draws a waveform from each version number. The installer and the update dialog show the same one, so you
          can tell a release by its shape.
        </p>
      </div>
      <!-- src: CLAUDE.md "Updater" (silent background download, what's-new dialog, install on quit, never mid-meeting); CHANGELOG.md 2.35.0 "show what's new before installing" -->
      <p class="text-[0.9375rem] leading-relaxed text-muted-foreground lg:col-span-5 lg:pb-1">
        Updates download quietly in the background. NexQ shows what is new before you install, installs when you quit, and
        never in the middle of a meeting.
      </p>
    </div>

    <div class="rel mt-12" data-rel>
      <div class="rel-bar">
        <p class="rel-count" id="rel-count">{entries.length} releases, newest first</p>
        <div class="rel-step" data-rel-step>
          <!-- Left and right arrows on the horizontal strip, up and down on the phone list (global CSS rotates them). -->
          <button type="button" class="rel-step__btn" data-rel-prev aria-label="Newer release">
            <Icon name="arrow-right" class="rel-step__i rel-step__i--prev h-4 w-4" />
          </button>
          <button type="button" class="rel-step__btn" data-rel-next aria-label="Older release">
            <Icon name="arrow-right" class="rel-step__i rel-step__i--next h-4 w-4" />
          </button>
        </div>
      </div>

      <div class="rel-strip-wrap" data-end="false">
        <div class="rel-strip" id="rel-strip" role="tablist" aria-label="NexQ releases" aria-orientation="horizontal" aria-describedby="rel-count" data-collapsed="true">
          {entries.map((e, i) => (
            <button
              type="button"
              role="tab"
              class="rel-tab"
              id={`rel-tab-${i}`}
              aria-controls={`rel-panel-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-more={i >= PHONE_VISIBLE ? '' : undefined}
              data-edge={i === PHONE_VISIBLE - 1 ? '' : undefined}
            >
              <span class="rel-tab__v">v{e.version}</span>
              <span class="rel-tab__d">{e.current ? 'Current' : e.shortDate}</span>
              <span class="rel-tab__w" aria-hidden="true">
                <Wave version={e.version} size="sm" label="" />
              </span>
            </button>
          ))}
        </div>
        {entries.length > PHONE_VISIBLE && (
          <button type="button" class="rel-all" data-rel-all aria-expanded="false" aria-controls="rel-strip">
            <span data-rel-all-label>Show all {entries.length} releases</span>
          </button>
        )}
      </div>

      <div class="rel-panels">
        {entries.map((e, i) => (
          <div class="rel-panel" id={`rel-panel-${i}`} data-rel-panel aria-labelledby={`rel-tab-${i}`}>
            <div class="rel-meta">
              <h3 class="rel-meta__v">v{e.version}</h3>
              {e.current && <span class="tag rel-meta__now">Current</span>}
              {e.dateLabel && (
                <span class="rel-meta__d">
                  {e.notesFrom ? `New in v${e.notesFrom}, ` : ''}{e.dateLabel}
                </span>
              )}
            </div>

            <div class="rel-stage" data-rel-stage>
              {i === 0 && <Wave version={e.version} size="lg" />}
            </div>

            <div class="rel-body">
              <p class="rel-headline">{e.headline}</p>
              <div class="rel-notes">
                {e.items.length > 0 && (
                  <ul class="rel-items">
                    {e.items.map((it) => <li>{it}</li>)}
                  </ul>
                )}
                <p class="rel-link">
                  {e.more > 0 && <span class="text-muted-foreground">and {e.more} more. </span>}
                  <a href={CHANGELOG} class="link">Full changelog</a>
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/rel-timeline.ts';
</script>

<style is:global>
  .rel-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .rel-count {
    font-size: 0.875rem;
    color: hsl(var(--muted-foreground));
  }
  /* The step buttons only mean something with JS. */
  .rel-step {
    display: none;
    gap: 0.375rem;
  }
  .js .rel-step {
    display: flex;
  }
  .rel-step__btn {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid hsl(var(--border));
    border-radius: 0.75rem;
    color: hsl(var(--foreground));
    transition:
      background-color 0.2s var(--ease-spring),
      border-color 0.2s var(--ease-spring);
  }
  .rel-step__btn:hover:not(:disabled) {
    border-color: hsl(var(--muted-foreground) / 0.5);
    background-color: hsl(var(--card));
  }
  .rel-step__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }
  /* The arrow icon points right. Wide strip: back is left, next is right. Phone list: up and down. */
  .rel-step__i--prev {
    transform: rotate(180deg);
  }
  @media (max-width: 767px) {
    .rel-step__i--prev {
      transform: rotate(-90deg);
    }
    .rel-step__i--next {
      transform: rotate(90deg);
    }
  }

  /* ─── The strip: a vertical list on phones, a horizontal snap strip from 768px ─── */
  .rel-strip-wrap {
    position: relative;
  }
  .rel-strip {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid hsl(var(--border));
    border-radius: 0.875rem;
    background: hsl(var(--card));
  }
  .rel-tab {
    position: relative;
    display: grid;
    grid-template-columns: 5.25rem 1fr;
    grid-template-areas: 'v w' 'd w';
    align-items: center;
    column-gap: 1rem;
    min-height: 3.75rem;
    padding: 0.5rem 1rem;
    text-align: left;
    border-bottom: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
    transition: background-color 0.25s var(--ease-spring);
  }
  .rel-tab:last-child {
    border-bottom: 0;
  }
  /* Phone list: only the newest few until "Show all". Without JS the strip is hidden anyway. */
  @media (max-width: 767px) {
    .rel-strip[data-collapsed='true'] .rel-tab[data-more] {
      display: none;
    }
    .rel-strip[data-collapsed='true'] .rel-tab[data-edge] {
      border-bottom: 0;
    }
  }
  .rel-all {
    display: none;
  }
  @media (max-width: 767px) {
    .js .rel-all {
      display: flex;
      width: 100%;
      min-height: 2.75rem;
      align-items: center;
      justify-content: center;
      margin-top: 0.5rem;
      border: 1px solid hsl(var(--border));
      border-radius: 0.75rem;
      font-size: 0.9375rem;
      font-weight: 600;
      color: hsl(var(--foreground));
      transition:
        background-color 0.2s var(--ease-spring),
        border-color 0.2s var(--ease-spring);
    }
    .js .rel-all:hover {
      border-color: hsl(var(--muted-foreground) / 0.5);
      background-color: hsl(var(--card));
    }
  }
  .rel-tab:hover {
    background-color: hsl(var(--secondary) / 0.5);
  }
  .rel-tab[aria-selected='true'] {
    background-color: hsl(var(--secondary));
    color: hsl(var(--foreground));
  }
  /* Selected marker: a 2px edge. Blue is progress in this palette, and this is the played wave's edge. */
  .rel-tab[aria-selected='true']::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: hsl(var(--primary));
  }
  .rel-tab:focus-visible {
    outline-offset: -3px;
  }
  .rel-tab__v {
    grid-area: v;
    align-self: end;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: hsl(var(--foreground));
    line-height: 1.3;
  }
  .rel-tab__d {
    grid-area: d;
    align-self: start;
    font-size: 0.75rem;
    line-height: 1.3;
  }
  .rel-tab__w {
    grid-area: w;
    display: block;
    min-width: 0;
  }
  .rel-tab .nx-wave {
    --wave-h: 22px;
    transition: --progress 1.1s var(--ease-spring);
  }
  /* Only the selected release's wave is played. Others rest (JS on); without JS all show fully played. */
  .js .rel-tab[aria-selected='false'] .nx-wave {
    --progress: 0 !important;
    transition-duration: 0.35s;
  }

  @media (min-width: 768px) {
    .rel-strip {
      flex-direction: row;
      max-height: none;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x proximity;
      scroll-padding-inline: 0.5rem;
      padding: 0.5rem;
      gap: 0.25rem;
    }
    .rel-tab {
      scroll-snap-align: start;
      flex: 0 0 11.5rem;
      grid-template-columns: 1fr;
      grid-template-areas: 'v' 'w' 'd';
      row-gap: 0.5rem;
      min-height: 0;
      padding: 0.875rem 0.875rem 0.75rem;
      border: 1px solid transparent;
      border-radius: 0.625rem;
    }
    .rel-tab:last-child {
      border-bottom: 1px solid transparent;
    }
    .rel-tab[aria-selected='true'] {
      border-color: hsl(var(--border));
    }
    .rel-tab[aria-selected='true']::before {
      inset: auto 0.875rem 0 0.875rem;
      width: auto;
      height: 2px;
      border-radius: 2px;
    }
    .rel-tab__v,
    .rel-tab__d {
      align-self: auto;
    }
    .rel-tab .nx-wave {
      --wave-h: 28px;
    }
  }

  /* Edge fade says there is more to scroll. JS sets data-end="true" at the end of the strip. */
  @media (min-width: 768px) {
    .rel-strip-wrap::after {
      content: '';
      pointer-events: none;
      position: absolute;
      inset: 1px 1px 1px auto;
      width: 3.5rem;
      border-radius: 0 0.8rem 0.8rem 0;
      background: linear-gradient(to left, hsl(var(--card)), hsl(var(--card) / 0));
      transition: opacity 0.25s var(--ease-spring);
    }
    .rel-strip-wrap[data-end='true']::after {
      opacity: 0;
    }
  }

  /* ─── Panels ─── */
  .rel-panels {
    margin-top: 1rem;
  }
  .rel-panel {
    padding: 1.5rem 0 0;
  }
  /* With JS every panel sits in the same grid cell, so the box is as tall as the tallest and never jumps. */
  .js .rel-panels {
    grid-template-columns: minmax(0, 1fr);
    display: grid;
  }
  .js .rel-panel {
    grid-area: 1 / 1;
  }
  .js .rel-panel[hidden] {
    display: block;
    visibility: hidden;
  }
  /* Without JS: the first release is expanded, the rest are a plain list. */
  html:not(.js) .rel-strip-wrap,
  html:not(.js) .rel-bar {
    display: none;
  }
  html:not(.js) .rel-panel:not(:first-child) {
    padding-top: 1rem;
    margin-top: 1rem;
    border-top: 1px solid hsl(var(--border));
  }
  html:not(.js) .rel-panel:not(:first-child) .rel-stage,
  html:not(.js) .rel-panel:not(:first-child) .rel-notes {
    display: none;
  }

  .rel-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.875rem;
  }
  .rel-meta__v {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .rel-meta__now {
    color: hsl(var(--foreground));
  }
  .rel-meta__d {
    font-size: 0.875rem;
    color: hsl(var(--muted-foreground));
  }

  .rel-stage {
    margin-top: 1rem;
    height: 4rem;
  }
  .rel-stage .nx-wave {
    --wave-h: 4rem;
    transition: --progress 1.4s var(--ease-spring);
  }
  @media (min-width: 768px) {
    .rel-stage {
      height: 6rem;
    }
    .rel-stage .nx-wave {
      --wave-h: 6rem;
    }
  }

  .rel-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem 3rem;
    margin-top: 1.5rem;
  }
  .rel-headline {
    font-size: clamp(1.375rem, 1.6vw + 0.9rem, 1.875rem);
    font-weight: 750;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: hsl(var(--foreground));
    text-wrap: balance;
  }
  .rel-items {
    display: grid;
    gap: 0.625rem;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: hsl(var(--muted-foreground));
  }
  .rel-items li {
    position: relative;
    padding-left: 1.125rem;
  }
  .rel-items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 1px;
    background: hsl(var(--muted-foreground));
  }
  .rel-link {
    margin-top: 1rem;
    font-size: 0.9375rem;
  }
  .rel-notes > .rel-link:first-child {
    margin-top: 0;
  }
  @media (min-width: 768px) {
    .rel-body {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }

  @media (forced-colors: active) {
    .rel-tab[aria-selected='true'] {
      outline: 2px solid Highlight;
      outline-offset: -2px;
    }
    .rel-strip,
    .rel-all,
    .rel-step__btn {
      border-color: ButtonText;
    }
  }
</style>
