---
/**
 * #demo: the recorded demo video, large and centred. Click to play: nothing is fetched until then
 * (scripts/demo-video.ts swaps the poster button for a <video controls>). The files have no audio track
 * (ffprobe: one video stream in the mp4 and the webm), so the lede says so and the player is muted.
 * Files: public/media/hero-demo.{webm,mp4} and hero-demo-poster.webp. VIDEO_W/H must match the files (ffprobe).
 */
import { SECTION } from '../data/site';
// The app version the video was recorded on. Change it only when the video is replaced.
const RECORDED_ON = '2.41.2';

const VIDEO_W = 1600;
const VIDEO_H = 1066;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const webm = `${base}media/hero-demo.webm`;
const mp4 = `${base}media/hero-demo.mp4`;
const poster = `${base}media/hero-demo-poster.webp`;
---

<section id={SECTION.demo} class="section demo-sec" aria-labelledby="demo-title">
  <div class="wrap">
    <h2 id="demo-title" class="h2 max-w-[20ch]">See the real app in a call.</h2>
    <p class="lede">
      This is NexQ's built-in demo mode on v{RECORDED_ON}, playing a scripted interview. The answer is slowed down so you can read it, and the recording has no sound.
    </p>

    <div class="demo-video mt-10" data-reveal>
      <div
        class="demo-video__frame"
        style={`aspect-ratio: ${VIDEO_W} / ${VIDEO_H}`}
        data-demo-video
        data-webm={webm}
        data-mp4={mp4}
        data-poster={poster}
      >
        <button type="button" class="demo-video__btn" aria-label="Play the demo video (no sound)">
          <img src={poster} width={VIDEO_W} height={VIDEO_H} loading="lazy" decoding="async" alt="" />
          <span class="demo-video__icon" aria-hidden="true">
            <svg viewBox="0 0 12 12" width="30" height="30"><path d="M3 1.5v9l7.5-4.5z" fill="currentColor" /></svg>
          </span>
        </button>
        <noscript>
          <video controls muted preload="none" width={VIDEO_W} height={VIDEO_H} poster={poster}>
            <source src={webm} type="video/webm" />
            <source src={mp4} type="video/mp4" />
          </video>
        </noscript>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/demo-video.ts';
</script>

<style is:global>
  /* Jump here from the hero link: the heading lands just under the nav (cancels the section's own top padding). */
  .demo-sec {
    scroll-margin-top: calc(0.5rem - 5rem);
  }
  @media (min-width: 640px) {
    .demo-sec {
      scroll-margin-top: calc(0.5rem - 7rem);
    }
  }

  .demo-video__frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: 0.875rem;
    background: hsl(var(--card));
  }
  .demo-video__frame video,
  .demo-video__frame img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .demo-video__frame img {
    object-fit: cover;
  }
  .demo-video__frame video {
    object-fit: contain;
    background: #000;
  }
  /* Fullscreen: the whole video, letterboxed. The frame's fixed aspect box and any cropping must not apply here
     (the cause of the crop was object-fit: cover on a viewport-sized video). */
  .demo-video__frame video:fullscreen {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: none;
    background: #000;
  }
  .demo-video__btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 0;
  }
  .demo-video__btn:focus-visible {
    outline-offset: -4px;
  }
  html:not(.js) .demo-video__btn {
    display: none;
  }
  .demo-video__icon {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    width: 5rem;
    height: 5rem;
    place-items: center;
    border-radius: 9999px;
    background: hsl(var(--primary-btn));
    color: #fff;
    box-shadow: 0 0 0 6px hsl(0 0% 0% / 0.28);
    transform: translate(-50%, -50%);
    transition: transform 0.3s var(--ease-spring);
  }
  .demo-video__icon svg {
    margin-left: 3px; /* optical centre of the triangle */
  }
  .demo-video__btn:hover .demo-video__icon {
    transform: translate(-50%, -50%) scale(1.06);
  }
  @media (max-width: 639px) {
    .demo-video__icon {
      width: 4rem;
      height: 4rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo-video__icon {
      transition: none;
    }
  }
  @media (forced-colors: active) {
    .demo-video__frame {
      border-color: ButtonText;
    }
    .demo-video__icon {
      border: 2px solid ButtonText;
      background: ButtonFace;
      color: ButtonText;
      box-shadow: none;
    }
  }
</style>
