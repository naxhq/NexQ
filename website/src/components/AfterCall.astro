---
/**
 * #after: "after 47:12". A DOM recreation of the past-meeting view (not a screenshot, so it stays
 * crisp and can move): header, tabs, transcript that follows a playhead, and the player bar.
 *
 * Source of the real thing (names, order, colours):
 *   tabs ........ src/launcher/meeting-details/MeetingTabBar.tsx (Transcript, Summary, Ask, AI Log,
 *                 Speakers, Actions, Bookmarks)
 *   rows ........ TranscriptRow.tsx (timestamp, bookmark mark, speaker, text; active row has a left
 *                 border and a tint; clicking a row seeks)
 *   player ...... src/components/AudioPlayer.tsx (play, time, waveform 36px, duration) and
 *                 WaveformCanvas.tsx (played bars, bookmark dots amber, topic dividers emerald,
 *                 click and drag to seek). The app paints played bars indigo; here progress is the
 *                 site's blue.
 *   Ask tab ..... AskMeetingTab.tsx (question bubble on the right, "Ask about this meeting…")
 *   AI Log ...... AIInteractionLog.tsx (mode label, question, latency, provider/model; "Ask this meeting" group)
 *   actions ..... ActionItemsTab.tsx (checkbox, text, assignee); types.ts ActionItem
 * Features list: README.md "Features" ("Audio recording with synced transcript playback", "Bookmarks,
 *   action items and topic sections", "Searchable meeting history, summaries and 'Ask a past
 *   meeting'", "AI Call Log: inspect every prompt, latency and token count").
 *
 * The meeting is the hero demo's interview (Dana, design hiring; components/overlay/content.ts), told
 * from the other side: what is left after "47:12". It is made up for this page. The existing
 * screenshots in public/ predate the Ask tab and show demo-mode data, so they are not used here.
 */
import { SECTION } from '../data/site';
import { CURRENT_VERSION, waveFor } from '../data/releases';
import {
  planHero, A_LINES, B_LINES, B_QUESTION, D_LINES, D_QUESTION, HERO_QUESTION, ANSWERS, C_ANSWER, D_ANSWER, C_REPLY, E_REPLY,
} from './overlay/content';

const DUR = 2832; // 47:12, in seconds
const START = 0.18; // where the playhead rests without JS and with reduced motion (the CTO ask, ~8:30)

const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
/** "m:ss" stamp to seconds. */
const secs = (ts: string) => {
  const [m, s] = ts.split(':').map(Number);
  return m * 60 + s;
};
/** Straight apostrophes in the shared sample text become typographic ones on this page. */
const curly = (t: string) => t.replace(/(\w)'(\w)/g, '$1’$2');
/** Latency the way the AI Log shows it (AIInteractionLog.tsx: `${latency_ms}ms`), from content.ts's one number. */
const logMs = (a: { totalMs: number }) => `${a.totalMs}ms`;

// The same interview as the hero demo and the beats above. Every line the overlay shows (hero opening,
// beats a, b and d) is read from components/overlay/content.ts, with the same stamps, so the recording
// and the call never disagree. Lines that are not on screen anywhere above are written here, with
// stamps that continue the call. [seconds, who, text, bookmarked, language]
const heroLines = planHero(waveFor(CURRENT_VERSION)).lines;
const fromContent = (ls: { who: 'you' | 'them'; ts: string; text: string }[], lang?: string, bm?: (text: string) => boolean) =>
  ls.map((l): [number, 'you' | 'them', string, boolean?, string?] => [
    secs(l.ts), l.who, curly(l.text), bm?.(l.text) || undefined, l.who === 'them' && lang ? lang : undefined,
  ]);
const LINES: [number, 'you' | 'them', string, boolean?, string?][] = [
  ...fromContent(heroLines, undefined, (t) => t === HERO_QUESTION),
  [49, 'you', 'We shipped the design system before the redesign. It cost two weeks up front, and every screen after that took days.'],
  ...fromContent(A_LINES, 'es', () => false),
  ...fromContent(B_LINES, undefined, (t) => t === B_QUESTION),
  ...fromContent([C_REPLY]),
  ...fromContent(D_LINES, undefined, (t) => t === D_QUESTION),
  ...fromContent([E_REPLY]),
  [2410, 'them', 'That’s all from me. Any questions before we wrap up?'],
  [2531, 'you', 'Yes, about the team roadmap. Can we cover it in the second round?'],
  [2700, 'them', 'Of course. I’ll send the invite for the CTO round tomorrow.'],
];
// Stamps must keep increasing, and the lines written here must sit between the lines they follow.
LINES.forEach((l, i) => {
  if (i > 0 && l[0] <= LINES[i - 1][0]) throw new Error(`AfterCall: transcript stamp ${fmt(l[0])} does not follow ${fmt(LINES[i - 1][0])}`);
});
const TOPICS: [number, string][] = [
  [0, 'Intro and trade-offs'],
  [109, 'Working with engineering'],
  [274, 'Dashboard speed'],
  [480, 'Second round'],
];
const BOOKMARKS: [number, string][] = [
  [LINES.find((l) => l[2] === HERO_QUESTION)![0], 'Toughest trade-off: the design system first'],
  [274, 'A slow dashboard with fifty charts'],
  [480, 'Second round with the CTO next week'],
];
const ACTIONS: { text: string; who: 'you' | 'them'; name: string; t: number; done?: boolean }[] = [
  { text: 'Offer Dana Tuesday after 2 pm or Thursday morning', who: 'you', name: 'You', t: secs(E_REPLY.ts), done: true },
  { text: 'Ask about the team roadmap in the second round', who: 'you', name: 'You', t: 2531 },
  { text: 'Send the invite for the CTO round', who: 'them', name: 'Dana', t: 2700 },
];
// Every request NexQ sent to the AI, with its answer. Titles, labels and timings of the three live answers come
// from content.ts (the first Assist's from ANSWERS.Assist.totalMs); Summary and Actions are made up like the meeting.
const LOG: { label: string; title: string; ms: string; meta: string }[] = [
  { label: ANSWERS.Assist.label, title: HERO_QUESTION, ms: logMs(ANSWERS.Assist), meta: 'claude_cli/haiku' },
  { label: C_ANSWER.label, title: B_QUESTION, ms: logMs(C_ANSWER), meta: 'claude_cli/haiku' },
  { label: D_ANSWER.label, title: D_QUESTION, ms: logMs(D_ANSWER), meta: 'claude_cli/haiku' },
  { label: 'Summary', title: 'Meeting summary', ms: '6240ms', meta: 'claude_cli/sonnet' },
  { label: 'Actions', title: 'Action items', ms: '3180ms', meta: 'claude_cli/sonnet' },
];
// Ask this meeting rows: label getModeLabel('MeetingAsk') = "Ask meeting" (src/lib/utils.ts:115-116), meta is the model alone
// (AIInteractionLog.tsx:49-51 passes answer.model, no provider, no latency).
const LOG_ASK = { label: 'Ask meeting', title: 'What did Dana say about the second round?', meta: 'sonnet' };

// A speech-shaped waveform, seeded so the build is stable. Not the release wave: that one means a version.
const N = 120;
let seed = 4721;
const rnd = () => ((seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0) / 4294967296);
let env = 0.4;
const raw: number[] = [];
for (let i = 0; i < N; i++) {
  // Phrases: a few bars rise and fall, then a pause.
  const phrase = Math.abs(Math.sin(i * 0.19 + 0.4)) ** 1.4;
  const quiet = Math.sin(i * 0.37 + 1.3) + Math.sin(i * 0.11) * 0.8 < -0.7;
  env = env * 0.35 + rnd() * 0.65;
  raw.push(quiet ? 0.015 + rnd() * 0.04 : 0.04 + phrase * env * 0.96);
}
const top = Math.max(...raw);
const H = 36;
const SLOT = 2;
const bars = raw
  .map((a, i) => {
    const h = Math.max(1.5, Math.sqrt(a / top) * H * 0.92);
    return `M${(i * SLOT + 0.2).toFixed(2)} ${((H - h) / 2).toFixed(2)}h1.6v${h.toFixed(2)}h-1.6z`;
  })
  .join('');

const pct = (t: number) => `${((t / DUR) * 100).toFixed(2)}%`;
const startSec = START * DUR;
const activeIdx = LINES.reduce((a, l, i) => (l[0] <= startSec ? i : a), -1);


const FEATURES: { tab: string; title: string; text: string }[] = [
  { tab: 'transcript', title: 'A recording that follows the transcript', text: 'Click a line to jump to that moment. Drag the waveform and the transcript scrolls with you.' },
  { tab: 'summary', title: 'Summary', text: 'Generate one from the transcript when you want it.' },
  { tab: 'actions', title: 'Action items', text: 'Pulled out of the conversation with who they belong to. Tick them off.' },
  { tab: 'bookmarks', title: 'Bookmarks and topic sections', text: 'Mark a moment yourself or let the AI suggest them. The green lines on the waveform are where the subject changed.' },
  { tab: 'ask', title: 'Ask a past meeting', text: 'Chat with the meeting. Questions and answers are saved with it.' },
  // src: README.md "Features" ("inspect every prompt, latency and token count"), docs/DEVELOPMENT.md L74 (every LLM request with
  // provider, model, prompt, timing, usage and errors), src/launcher/meeting-details/AIInteractionLog.tsx (mode label,
  // question, latency, provider/model, the response), src/lib/utils.ts getModeLabel (Summary and Actions are logged too).
  { tab: 'ai', title: 'AI Call Log', text: 'Every prompt and the answer it got, with timing, tokens and the model behind it. Summaries and action items are logged too, not only the answers you asked for.' },
];
const TABS = [
  { id: 'transcript', label: 'Transcript', count: LINES.length },
  { id: 'summary', label: 'Summary' },
  { id: 'ask', label: 'Ask' },
  { id: 'ai', label: 'AI Log', count: LOG.length + 1 },
  { id: 'actions', label: 'Actions', count: ACTIONS.length },
  { id: 'bookmarks', label: 'Bookmarks', count: BOOKMARKS.length },
];
---

<section id={SECTION.after} class="section ac-sec" aria-labelledby="after-title">
  <div class="wrap">
    <p class="eyebrow">after 47:12</p>
    <h2 id="after-title" class="h2 mt-3 max-w-[20ch]">Everything is still there afterwards.</h2>
    <p class="lede">
      The interview with Dana ends at 47:12, and the work is not over. NexQ keeps the recording, with a
      transcript that follows it, and the notes you would otherwise write by hand.
    </p>

    <div class="ac-grid">
      <div class="ac-main" data-reveal>
        <div
          class="ac"
          data-ac
          data-dur={DUR}
          data-rest={START}
          role="group"
          aria-label="Sample past meeting, Design interview with Dana, 47 minutes 12 seconds. The same made-up interview as the demo above."
        >
          <header class="ac-head">
            <svg class="ac-back" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M13 8H3m4-4L3 8l4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <div>
              <p class="ac-title">Design interview with Dana</p>
              <p class="ac-meta">2h ago · 47:12 · {LINES.length} segments</p>
            </div>
          </header>

          <div class="ac-tabs-wrap" data-ac-tabs-wrap>
          <div class="ac-tabs" role="tablist" aria-label="Meeting views" data-ac-tabs>
            {TABS.map((t, i) => (
              <button type="button" role="tab" id={`ac-tab-${t.id}`} aria-controls={`ac-panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={t.id}>
                {t.label}{t.count !== undefined && <span class="ac-count">{t.count}</span>}
              </button>
            ))}
          </div>
          </div>

          <div class="ac-body">
            <!-- Transcript -->
            <div class="ac-panel" role="tabpanel" id="ac-panel-transcript" aria-labelledby="ac-tab-transcript" data-on data-ac-lines tabindex="-1">
              <h4 class="ac-nojs-h">Transcript</h4>
              <ol class="ac-lines" aria-label="Transcript lines. Up and down arrows move between them.">
                {LINES.map(([t, who, text, bm, lang], i) => (
                  <li>
                    <button type="button" class="ac-line" data-t={t} tabindex={i === activeIdx ? 0 : -1} lang={lang} aria-current={i === activeIdx ? 'true' : undefined} aria-label={`${fmt(t)} ${who === 'you' ? 'You' : 'Dana'}: ${text}`}>
                      <span class="ac-ts">{fmt(t)}</span>
                      {bm ? <svg class="ac-bm" viewBox="0 0 10 12" width="10" height="12" aria-hidden="true"><path d="M1.5 1h7v10L5 8.5 1.5 11z" fill="currentColor" /></svg> : <span class="ac-bm" aria-hidden="true"></span>}
                      <span class="ac-who" data-w={who} aria-hidden="true">{who === 'you' ? 'You' : 'Dana'}</span>
                      <span class="ac-tx" aria-hidden="true">{text}</span>
                    </button>
                  </li>
                ))}
              </ol>
            </div>

            <!-- Summary -->
            <div class="ac-panel" role="tabpanel" id="ac-panel-summary" aria-labelledby="ac-tab-summary" tabindex="-1">
              <h4 class="ac-nojs-h">Summary</h4>
              <div class="ac-prose">
                <p>Design interview with Dana, who leads hiring for the design team. You talked through the toughest trade-off on your last project, how you work with engineering and how to make a slow dashboard feel fast. Dana asked for a second round with the CTO next week.</p>
                <p class="ac-prose__h">Key points</p>
                <ul>
                  <li>Toughest trade-off: the design system came before the redesign. Two weeks slower, then days per screen.</li>
                  <li>You pair with engineers from day one.</li>
                  <li>A slow dashboard: show something useful first, then stream the charts.</li>
                  <li>Second round with the CTO next week: Tuesday after 2 pm or Thursday morning.</li>
                  <li>Your roadmap questions wait for that round.</li>
                </ul>
              </div>
            </div>

            <!-- Ask -->
            <div class="ac-panel" role="tabpanel" id="ac-panel-ask" aria-labelledby="ac-tab-ask" tabindex="-1">
              <h4 class="ac-nojs-h">Ask</h4>
              <div class="ac-chat">
                <p class="ac-q">What did Dana say about the second round?</p>
                <div class="ac-prose">
                  <p>She asked whether you can do a second round with the CTO next week.</p>
                  <ul>
                    <li>You offered Tuesday after 2 pm or Thursday morning.</li>
                    <li>She will send the invite for the CTO round tomorrow.</li>
                    <li>You asked to cover the team roadmap in that round.</li>
                  </ul>
                </div>
                <p class="ac-ask" aria-hidden="true">Ask about this meeting…</p>
              </div>
            </div>

            <!-- AI Log -->
            <div class="ac-panel" role="tabpanel" id="ac-panel-ai" aria-labelledby="ac-tab-ai" tabindex="-1">
              <h4 class="ac-nojs-h">AI Log</h4>
              <ul class="ac-log">
                {LOG.map((l) => (
                  <li>
                    <span class="ac-pill">{l.label}</span>
                    <span class="ac-log__t">{l.title}</span>
                    <span class="ac-log__m">{l.ms} · {l.meta}</span>
                  </li>
                ))}
              </ul>
              <p class="ac-log__g">Ask this meeting</p>
              <ul class="ac-log">
                <li>
                  <span class="ac-pill">{LOG_ASK.label}</span>
                  <span class="ac-log__t">{LOG_ASK.title}</span>
                  <span class="ac-log__m">{LOG_ASK.meta}</span>
                </li>
              </ul>
            </div>

            <!-- Actions -->
            <div class="ac-panel" role="tabpanel" id="ac-panel-actions" aria-labelledby="ac-tab-actions" tabindex="-1">
              <h4 class="ac-nojs-h">Actions</h4>
              <ul class="ac-acts">
                {ACTIONS.map((a) => (
                  <li data-done={a.done ? '' : undefined}>
                    <span class="ac-check" aria-hidden="true">{a.done && <svg viewBox="0 0 12 12" width="10" height="10"><path d="M2.5 6.5l2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>}</span>
                    <span class="ac-acts__t">{a.text}{a.done && <span class="sr-only"> (done)</span>}</span>
                    <span class="ac-who" data-w={a.who}>{a.name}</span>
                    <button type="button" class="ac-ts ac-ts--btn" data-seek={a.t} aria-label={`Jump to ${fmt(a.t)}`}>{fmt(a.t)}</button>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Bookmarks -->
            <div class="ac-panel" role="tabpanel" id="ac-panel-bookmarks" aria-labelledby="ac-tab-bookmarks" tabindex="-1">
              <h4 class="ac-nojs-h">Bookmarks</h4>
              <ul class="ac-bms">
                {BOOKMARKS.map(([t, note]) => (
                  <li>
                    <button type="button" data-seek={t}>
                      <span class="ac-ts">{fmt(t)}</span>
                      <svg class="ac-bm ac-bm--on" viewBox="0 0 10 12" width="10" height="12" aria-hidden="true"><path d="M1.5 1h7v10L5 8.5 1.5 11z" fill="currentColor" /></svg>
                      <span>{note}</span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Player bar: the app's AudioPlayer. -->
          <div class="ac-player">
            <button type="button" class="ac-play" data-ac-play aria-label="Play">
              <svg class="ac-play__i ac-play__i--play" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M3 1.5v9l7.5-4.5z" fill="currentColor" /></svg>
              <svg class="ac-play__i ac-play__i--pause" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M3 1.5h2v9H3zm4 0h2v9H7z" fill="currentColor" /></svg>
            </button>
            <span class="ac-clock" data-ac-now aria-hidden="true">{fmt(Math.floor(startSec))}</span>
            <div
              class="ac-wave"
              data-ac-slider
              role="slider"
              style={`--progress:${START}`}
              tabindex="0"
              aria-label="Playback position"
              aria-valuemin="0"
              aria-valuemax={DUR}
              aria-valuenow={Math.floor(startSec)}
              aria-valuetext={`${fmt(Math.floor(startSec))} of ${fmt(DUR)}`}
            >
              <svg class="ac-wave__rest" viewBox={`0 0 ${N * SLOT} ${H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d={bars}></path></svg>
              <svg class="ac-wave__done" viewBox={`0 0 ${N * SLOT} ${H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d={bars}></path></svg>
              {TOPICS.slice(1).map(([t]) => <i class="ac-topic" style={`left:${pct(t)}`} aria-hidden="true"></i>)}
              {BOOKMARKS.map(([t]) => <i class="ac-dot" style={`left:${pct(t)}`} aria-hidden="true"></i>)}
              <i class="ac-head-line" aria-hidden="true"></i>
            </div>
            <span class="ac-dur" aria-hidden="true">{fmt(DUR)}</span>
          </div>
        </div>
        <p class="ac-cap">
          The same made-up interview as the demo above. There is no sound here: the playhead runs fast so you can watch the transcript follow it.
          Green lines mark topic changes, amber dots mark bookmarks.
        </p>
      </div>

      <ol class="ac-feats" data-reveal>
        {FEATURES.map((f) => (
          <li>
            <button type="button" data-go={f.tab}>
              <span class="ac-feats__t">{f.title}</span>
              <span class="ac-feats__d">{f.text}</span>
            </button>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .ac-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    margin-top: 3.5rem;
  }
  @media (min-width: 1024px) {
    .ac-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: 4rem;
      align-items: start;
    }
  }

  /* ─── The window. App fonts, because it stands in for the app. ─── */
  .ac {
    --ac-pad: 1.25rem;
    /* Blue text on a blue tint needs to be lighter than the button blue to pass AA. */
    --ac-blue-text: hsl(213 94% 76%);
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: 0.875rem;
    background: hsl(var(--card));
    font-family: var(--font-app);
    font-size: 0.875rem;
    line-height: 1.45;
    box-shadow: 0 24px 60px -30px rgb(0 0 0 / 0.7);
  }
  .ac-head {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem var(--ac-pad);
  }
  .ac-back {
    flex: none;
    color: hsl(var(--muted-foreground));
  }
  .ac-title {
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.25;
  }
  .ac-meta {
    font-size: 0.75rem;
    color: hsl(var(--muted-foreground));
  }

  /* Tabs scroll sideways when they do not fit. The edge that still has tabs beyond it fades out (set by after-player.ts). */
  .ac-tabs-wrap {
    border-top: 1px solid hsl(var(--border) / 0.6);
    border-bottom: 1px solid hsl(var(--border) / 0.6);
  }
  .ac-tabs-wrap[data-more-l] .ac-tabs,
  .ac-tabs-wrap[data-more-r] .ac-tabs {
    --fl: 0rem;
    --fr: 0rem;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 var(--fl), #000 calc(100% - var(--fr)), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 var(--fl), #000 calc(100% - var(--fr)), transparent 100%);
  }
  .ac-tabs-wrap[data-more-l] .ac-tabs {
    --fl: 2.25rem;
  }
  .ac-tabs-wrap[data-more-r] .ac-tabs {
    --fr: 2.25rem;
  }
  .ac-tabs {
    position: relative; /* offsetParent for revealing a picked tab */
    display: flex;
    gap: 0.25rem;
    padding: 0.375rem 0.75rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .ac-tabs::-webkit-scrollbar {
    display: none;
  }
  .ac-tabs button {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    padding: 0 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
    transition:
      color 0.2s var(--ease-spring),
      background-color 0.2s var(--ease-spring);
  }
  .ac-tabs button:hover {
    color: hsl(var(--foreground));
  }
  .ac-tabs button[aria-selected='true'] {
    color: var(--ac-blue-text);
    background: hsl(var(--primary) / 0.1);
  }
  .ac-count {
    padding: 0 0.375rem;
    border-radius: 0.375rem;
    background: hsl(var(--secondary));
    font-size: 0.75rem;
    line-height: 1.4;
    color: hsl(var(--muted-foreground));
  }
  :global(html:not(.js)) .ac-tabs-wrap {
    display: none;
  }

  .ac-body {
    position: relative;
  }
  .ac-panel {
    overflow-y: auto;
    padding: 0.5rem 0.5rem;
    outline-offset: -2px;
  }
  /* Without JS the transcript scrolls and the other views are shown in full beneath it. */
  .ac-panel[data-ac-lines] {
    max-height: 21rem;
  }
  @media (max-width: 639px) {
    .ac-panel[data-ac-lines] {
      max-height: 26rem;
    }
  }
  :global(.js) .ac-panel {
    position: relative;
    height: 21rem;
    max-height: none;
  }
  @media (max-width: 639px) {
    :global(.js) .ac-panel {
      height: 26rem;
    }
  }
  :global(.js) .ac-panel:not([data-on]) {
    display: none;
  }
  :global(.js) .ac-panel[data-on] {
    animation: ac-in 0.4s var(--ease-spring);
  }
  @keyframes ac-in {
    from {
      opacity: 0;
      transform: translate3d(0, 6px, 0);
    }
  }
  .ac-nojs-h {
    padding: 0.5rem 0.75rem;
