---
/**
 * The close. Plain and confident: one blue action, one quiet link, the logo, no decoration.
 * On phones the button says what the hero says ("Get it for Windows or Mac"); the nav says "Download".
 */
import Icon from './Icon.astro';
import { CURRENT_VERSION } from '../data/releases';
import { REPO, SECTION } from '../data/site';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section id="final-cta" class="section border-t border-border" aria-labelledby="final-cta-title">
  <div class="wrap">
    <img src={`${base}img/logo-96.png`} alt="" width="56" height="56" loading="lazy" decoding="async" class="rounded-[14px]" />
    <h2 id="final-cta-title" class="display mt-8 max-w-[14ch] text-balance">Walk into your next call prepared.</h2>
    <p class="lede">Free, open source, and no bot joins your call. Windows and Mac.</p>
    <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
      <a href={`#${SECTION.download}`} class="btn-primary min-h-[52px] px-6 text-base">
        <Icon name="download" class="h-5 w-5" />
        <span class="sm:hidden">Get it for Windows or Mac</span>
        <span class="hidden sm:inline">Download NexQ</span>
      </a>
      <a href={REPO} class="btn-ghost min-h-[52px] px-6 text-base">
        <Icon name="github" class="h-5 w-5" />
        Star on GitHub
      </a>
    </div>
    <p class="mt-6 text-sm text-muted-foreground"><span class="font-mono">v{CURRENT_VERSION}</span> · MIT license</p>
  </div>
</section>
