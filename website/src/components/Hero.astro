---
import Icon from './Icon.astro';
import { RELEASES_LATEST, REPO } from '../data/site';

const base = import.meta.env.BASE_URL;
const proof = [
  { value: '11', label: 'speech-to-text engines' },
  { value: '9', label: 'AI providers, local or cloud' },
  { value: '0', label: 'bots in your meeting' },
  { value: 'MIT', label: 'open source, free forever' },
];
---

<section class="relative overflow-hidden pt-28 sm:pt-36" aria-labelledby="hero-title">
  <!-- Quiet top light: neutral, not decorative color -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[38rem]"
    style="background: radial-gradient(60% 50% at 50% 0%, rgba(238,241,247,0.06) 0%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <div class="wrap relative">
    <a
      href="#whats-new"
      class="hero-in group inline-flex max-w-full items-center gap-2.5 rounded-full border border-line-strong bg-bg-raised/70 py-1.5 pl-2 pr-3.5 text-[0.8125rem] text-ink-2 transition-colors hover:border-[rgba(160,175,215,0.32)] hover:text-ink"
      style="--d: 0ms"
    >
      <span class="rounded-full bg-brand/15 px-2 py-0.5 font-mono text-[0.6875rem] font-medium text-brand-ink">v2.25</span>
      <span class="truncate">macOS beta and Hide from screen share</span>
      <Icon name="arrow-right" class="h-3.5 w-3.5 shrink-0 transition-transform duration-300 ease-spring group-hover:translate-x-0.5" />
    </a>

    <h1
      id="hero-title"
      class="hero-in mt-7 max-w-4xl text-[2.6rem] font-semibold leading-[1.02] tracking-[-0.045em] text-ink sm:text-6xl sm:leading-none lg:text-[5.25rem]"
      style="--d: 80ms"
    >
      The meeting copilot that stays on <span class="font-serif font-normal italic tracking-[-0.02em] text-ink">your side</span> of the screen.
    </h1>

    <p class="hero-in mt-6 max-w-2xl text-lg leading-relaxed text-ink-2 sm:text-xl sm:leading-7" style="--d: 160ms">
      NexQ transcribes both sides of the call in real time and helps you answer in seconds, from a private overlay
      you can hide from screen share. No bot joins. Bring local models, any API, or your Claude subscription. Free and open source.
    </p>

    <div class="hero-in mt-9 flex flex-col gap-3 sm:flex-row sm:items-center" style="--d: 240ms">
      <a href={RELEASES_LATEST} class="btn-primary sm:px-6!" data-download-cta>
        <Icon name="download" />
        <span data-download-label>Download for Windows</span>
      </a>
      <a href={REPO} target="_blank" rel="noopener" class="btn-ghost">
        <Icon name="github" />
        Star on GitHub
      </a>
    </div>
    <p class="hero-in mt-4 text-sm text-ink-3" style="--d: 300ms">
      Windows 10/11 <span aria-hidden="true">·</span> macOS on Apple Silicon (beta) <span aria-hidden="true">·</span>
      <a href="#download" class="underline decoration-line-strong underline-offset-4 hover:text-ink-2">other options</a>
    </p>

    <figure class="hero-in relative mt-16 sm:mt-20" style="--d: 380ms">
      <div class="frame relative">
        <video
          id="hero-video"
          class="block aspect-[1600/1162] w-full"
          width="1600"
          height="1162"
          muted
          loop
          playsinline
          preload="metadata"
          poster={`${base}media/hero-demo-poster.webp`}
          aria-describedby="hero-video-caption"
        >
          <source src={`${base}media/hero-demo.webm`} type="video/webm" />
          <source src={`${base}media/hero-demo.mp4`} type="video/mp4" />
        </video>
        <button
          id="hero-video-toggle"
          type="button"
          class="absolute bottom-3 right-3 hidden h-9 items-center gap-2 rounded-full border border-line-strong bg-bg/80 px-3 text-xs font-medium text-ink-2 backdrop-blur-sm hover:text-ink"
          aria-pressed="false"
        >
          <span data-state-label>Pause</span>
          <span class="sr-only">demo video</span>
        </button>
      </div>
      <figcaption id="hero-video-caption" class="mt-4 flex items-center gap-2.5 text-sm text-ink-3">
        <span class="live-dot" aria-hidden="true"></span>
        A live technical interview in NexQ's demo mode: both sides transcribed and translated, the question detected, an answer one keypress away.
      </figcaption>
    </figure>

    <dl class="mt-16 grid grid-cols-2 gap-x-6 gap-y-8 border-t border-line pt-10 sm:mt-20 lg:grid-cols-4">
      {proof.map((p, i) => (
        <div data-reveal style={`--reveal-delay: ${i * 70}ms`}>
          <dt class="sr-only">{p.label}</dt>
          <dd class="text-4xl font-semibold tracking-[-0.04em] text-ink sm:text-5xl">{p.value}</dd>
          <dd class="mt-2 text-sm text-ink-3">{p.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;
  const toggle = document.getElementById('hero-video-toggle');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (video && toggle) {
    const label = toggle.querySelector('[data-state-label]');
    const sync = () => {
      const paused = video.paused;
      toggle.setAttribute('aria-pressed', String(paused));
      if (label) label.textContent = paused ? 'Play' : 'Pause';
    };
    toggle.classList.remove('hidden');
    toggle.classList.add('inline-flex');
    toggle.addEventListener('click', () => {
      if (video.paused) video.play().catch(() => {});
      else video.pause();
    });
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);

    if (!reduce.matches) {
      // Start only when visible, pause when scrolled away to save battery.
      const io = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting && !video.dataset.userPaused) video.play().catch(() => {});
          else if (!entry.isIntersecting) video.pause();
        },
        { threshold: 0.25 },
      );
      io.observe(video);
      toggle.addEventListener('click', () => {
        video.dataset.userPaused = video.paused ? '1' : '';
      });
    }
    sync();
  }
</script>
