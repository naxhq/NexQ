---
/**
 * #compare: a short, honest table. Rows are the README's "How NexQ compares" table
 * (README.md, "How NexQ compares"), with the counts fixed to 11 speech engines and 9 AI providers
 * (site.ts COUNTS). The table sits in its own scroll container, so the page never scrolls sideways.
 */
import Icon from './Icon.astro';
import { COUNTS, SECTION } from '../data/site';

const cols = ['NexQ', 'Otter.ai', 'Granola', 'Krisp'];
type Cell = string | boolean;
// src: README.md "How NexQ compares". Competitor cells are what the README lists; "Paid tiers" and "Fixed" are its words.
const rows: { label: string; values: Cell[] }[] = [
  { label: 'Price', values: ['Free', 'Paid tiers', 'Paid tiers', 'Paid tiers'] },
  { label: 'Open source', values: [true, false, false, false] },
  { label: 'Works without a meeting bot', values: [true, false, true, true] },
  { label: 'Fully local option', values: [true, false, false, 'Partial'] },
  { label: 'Speech engines / AI providers', values: [`${COUNTS.stt} / ${COUNTS.llm}`, 'Fixed', 'Fixed', 'Fixed'] },
  { label: 'Local LLM', values: [true, false, false, false] },
  { label: 'Your own documents as context', values: [true, false, false, false] },
];
---

<section id={SECTION.compare} class="section border-t border-border" aria-labelledby="compare-title">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-16">
      <div class="lg:col-span-7">
        <h2 id="compare-title" class="h2">Your calls shouldn’t be a subscription.</h2>
      </div>
      <p class="text-[0.9375rem] leading-relaxed text-muted-foreground lg:col-span-5 lg:pb-1">
        Otter.ai, Granola and Krisp each come with their own engine. NexQ lets you pick your speech and AI providers, and
        run all of it on your own computer.
      </p>
    </div>

    <div class="cmp mt-12" role="region" aria-label="Comparison of NexQ with Otter.ai, Granola and Krisp" data-cmp>
      <table class="cmp-table">
        <caption class="cmp-caption">Checked Nov 2026</caption>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Feature</span></th>
            {cols.map((c, i) => (
              <th scope="col" class:list={[i === 0 && 'cmp-us']}>{c}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row">{r.label}</th>
              {r.values.map((v, i) => (
                <td class:list={[i === 0 && 'cmp-us', v === false && 'cmp-no']}>
                  {v === true ? (
                    <span class="cmp-yes"><Icon name="check" class="h-4 w-4" />Yes</span>
                  ) : v === false ? (
                    'No'
                  ) : (
                    v
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="cmp-note">
      Competitor details are taken from the NexQ README and change over time, so check each vendor’s own page.
      “Fully local option” for NexQ means choosing an on-device speech engine and a local model.
    </p>
  </div>
</section>

<!-- The scroll region joins the tab order only while it really scrolls sideways, so keyboard users can pan it. -->
<script>
  const cmp = document.querySelector<HTMLElement>('[data-cmp]');
  if (cmp) {
    const sync = () => {
      if (cmp.scrollWidth > cmp.clientWidth) cmp.tabIndex = 0;
      else cmp.removeAttribute('tabindex');
    };
    sync();
    window.addEventListener('resize', sync);
    // The table can grow after the web fonts arrive, without any window resize.
    const table = cmp.querySelector('table');
    if (table && typeof ResizeObserver !== 'undefined') new ResizeObserver(sync).observe(table);
  }
</script>

<style is:global>
  .cmp {
    overflow-x: auto;
    border: 1px solid hsl(var(--border));
    border-radius: 1rem;
  }
  .cmp-table {
    width: 100%;
    min-width: 19rem;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.8125rem;
    line-height: 1.35;
  }
  /* A visible caption: it dates the table. */
  .cmp-caption {
    caption-side: bottom;
    border-top: 1px solid hsl(var(--border));
    padding: 0.75rem 0.75rem;
    text-align: left;
    font-size: 0.8125rem;
    color: hsl(var(--muted-foreground));
  }
  .cmp-table th,
  .cmp-table td {
    padding: 0.75rem 0.375rem;
    vertical-align: middle;
  }
  .cmp-table thead th {
    font-size: 0.8125rem;
    font-weight: 600;
    text-align: center;
    color: hsl(var(--muted-foreground));
    border-bottom: 1px solid hsl(var(--border));
  }
  .cmp-table tbody tr + tr > * {
    border-top: 1px solid hsl(var(--border));
  }
  .cmp-table tbody th {
    padding-left: 0.75rem;
    font-weight: 500;
    color: hsl(var(--foreground));
  }
  .cmp-table td {
    text-align: center;
    color: hsl(var(--muted-foreground));
  }
  .cmp-table .cmp-no {
    color: hsl(var(--muted-foreground));
  }
  /* Our column: a lifted surface, not a colour. */
  .cmp-table .cmp-us {
    background-color: hsl(var(--secondary));
    color: hsl(var(--foreground));
    font-weight: 600;
  }
  .cmp-yes {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .cmp-yes svg {
    display: none;
  }
  .cmp-note {
    margin-top: 1rem;
    max-width: 44rem;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: hsl(var(--muted-foreground));
  }

  @media (min-width: 480px) {
    .cmp-table {
      font-size: 0.9375rem;
    }
    .cmp-table th,
    .cmp-table td {
      padding: 0.875rem 0.75rem;
    }
    .cmp-table tbody th {
      padding-left: 1.25rem;
    }
    .cmp-yes svg {
      display: block;
    }
  }
  @media (min-width: 768px) {
    .cmp-table {
      min-width: 36rem;
    }
    .cmp-table tbody th {
      width: 34%;
    }
  }
  @media (forced-colors: active) {
    .cmp,
    .cmp-caption,
    .cmp-table thead th,
    .cmp-table tbody tr + tr > * {
      border-color: ButtonText;
    }
  }
</style>
