---
// Page order = the story of one call: first word to recap. Each section is its own
// component (and its own id, see SECTION in data/site.ts).
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import YourAI from '../components/YourAI.astro';
import AfterCall from '../components/AfterCall.astro';
import Demo from '../components/Demo.astro';
import MadeFor from '../components/MadeFor.astro';
import Privacy from '../components/Privacy.astro';
import Releases from '../components/Releases.astro';
import Download from '../components/Download.astro';
import Compare from '../components/Compare.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <main id="main" tabindex="-1" class="outline-hidden">
    <Hero />
    <YourAI />
    <AfterCall />
    <Demo />
    <MadeFor />
    <Privacy />
    <Releases />
    <Download />
    <Compare />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
